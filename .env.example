# ─────────────────────────────────────────────────────────────
# نمونه تنظیمات — این فایل را با نام «.env» کنار main.py کپی کن
# و مقدارهای واقعی را داخل .env بگذار (نه در این فایل).
# فایل .env در .gitignore قرار دارد و به گیت فرستاده نمی‌شود.
# ─────────────────────────────────────────────────────────────

# ---------- ۱) مدل هوش مصنوعی (سرویس سازگار با OpenAI) ----------
# کلید API را از سرویس خودت بگیر (ضروری)
OPENAI_API_KEY=thk_live_trltT5R2cEEjM12mLMiZwoeS21BWas6Vi-wzIeWtXIVD1cYlF6Rpa67P3jPaHvNt

# آدرس پایه سرویس. اگر از سرویس رسمی OpenAI استفاده می‌کنی، این خط را خالی بگذار
OPENAI_BASE_URL=https://api.gapgpt.app/v1

# نام مدلی که می‌خواهی استفاده کنی (باید از tool calling پشتیبانی کند)
OPENAI_MODEL=gpt-4o-mini

# ---------- ۱-ب) مهلتهای تماس با مدل (اختیاری) ----------
# نکته: کلاینت openai بهصورت پیشفرض فقط ۵ ثانیه برای «برقراری اتصال» مهلت میدهد.
# روی شبکههای کند (یا پشت پروکسی/VPN) همین مهلت کوتاه باعث خطای
# «ارتباط با مدل برقرار نشد» میشود، در حالی که تنظیمات همین فایل درست است.
# مهلت برقراری اتصال با مدل (ثانیه) — اگر خطای timeout گرفتی، بیشترش کن
OPENAI_CONNECT_TIMEOUT=30

# مهلت انتظار برای پاسخ مدل (ثانیه) — برای مقالههای بلند بیشترش کن
OPENAI_READ_TIMEOUT=300

# تعداد تلاش مجدد در صورت خطای موقت شبکه
OPENAI_MAX_RETRIES=2

# ---------- ۲) سرویس جست‌وجوی اینترنت ----------
# wikipedia = جست‌وجو در ویکی‌پدیای فارسی (بدون کلید، پیش‌فرض)
# tavily    = جست‌وجوی عمومی وب با Tavily (نیازمند SEARCH_API_KEY)
SEARCH_PROVIDER=wikipedia

# فقط برای SEARCH_PROVIDER=tavily لازم است
# کلید رایگان: https://tavily.com  (پلن رایگان ماهانه دارد)
SEARCH_API_KEY=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

# بیشترین تعداد نتیجه‌ای که از جست‌وجو برگردانده می‌شود
SEARCH_MAX_RESULTS=5

# مهلت (ثانیه) برای تماس با سرویس جست‌وجو
SEARCH_TIMEOUT=25

# ---------- ۲-ب) فشرده‌سازی Context (Compaction) ----------
# پیش از فرستادن نتایج جست‌وجو به مدل، Context کوچک می‌شود تا حجم درخواست پایین بماند.
# راهبرد پیش‌فرض «پنجره لغزان» (Sliding Window) است: پنجره روی تازه‌ترین نتایج
# می‌نشیند و اگر مجموع نویسه‌ها از سقف بگذرد، قدیمی‌ترین نتیجه‌ی داخل پنجره
# بیرون می‌افتد (تازه‌ترین‌ها می‌مانند).
#   sliding  = پنجره لغزان روی تازه‌ترین نتایج (پیش‌فرض)
#   truncate = رفتار ساده: فقط N نتیجه‌ی اول می‌ماند
COMPACTION_STRATEGY=sliding

# اندازه‌ی پنجره: بیشترین تعداد نتایجی که در Context می‌ماند
COMPACTION_WINDOW=3

# بیشترین نویسه‌ی «خلاصه» هر نتیجه (عنوان و لینک کامل حفظ می‌شوند)
COMPACTION_SNIPPET_LIMIT=250

# سقف نویسه‌ی مجموع نتایج هر پیام tool؛ پنجره تا رعایت شدن این سقف می‌لغزد
COMPACTION_MAX_CHARS=1500

# سقف نویسه‌ی تاریخچه‌ی مکالمه («پنجره لغزان» روی پیام‌ها) و کمترین شمار
# پیام‌های آخری که در هر حالت نگه داشته می‌شوند
COMPACTION_HISTORY_MAX_CHARS=8000
COMPACTION_HISTORY_MIN_MESSAGES=4

# ---------- ۳) محل ذخیره مقاله‌ها ----------
# مسیر نسبی به پوشه پروژه. خالی بگذاری، پیش‌فرض research_notes استفاده می‌شود
RESEARCH_NOTES_DIR=research_notes
